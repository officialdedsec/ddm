#include <windows.h>
1 ICON "ddm.ico"
1 RT_MANIFEST "ddm.manifest"
CACERT RCDATA "cacert.crt"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 4,0,0,0
PRODUCTVERSION 4,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "DedSec Cyber Security Research Institute"
      VALUE "FileDescription", "DedSec Download Manager"
      VALUE "FileVersion", "4.0.0"
      VALUE "InternalName", "DDM"
      VALUE "LegalCopyright", "(c) 2026 DedSec Cyber Security Research Institute"
      VALUE "OriginalFilename", "DDM.exe"
      VALUE "ProductName", "DDM - DedSec Download Manager"
      VALUE "ProductVersion", "4.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

#include "helpres.rc"
