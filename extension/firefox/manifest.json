{
  "manifest_version": 2,
  "name": "DDM — DedSec Download Manager",
  "short_name": "DDM",
  "version": "4.0.8",
  "description": "Sends downloads and videos to DDM for Windows: 32 connections, resume, safety checks, a Download this video button.",
  "author": "DedSec Cyber Security Research Institute",
  "homepage_url": "https://dedseec.com",
  "browser_specific_settings": {
    "gecko": {
      "id": "ddm@dedseec.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "webRequest",
    "storage",
    "tabs",
    "contextMenus",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "grab.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "ttinject.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "DDM — click to turn it off on this tab",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    "ttpage.js"
  ]
}
